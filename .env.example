# Docker Model Runner (local)
DMR_BASE_URL=http://localhost:12434
LOCAL_MODEL=ai/qwen3-coder

# Environment selector for the dev/prod parity example
# Values: development | production
ENVIRONMENT=development

# Microsoft Foundry / Azure OpenAI (production target for the OpenAI SDK)
# Get these from your Foundry project resource
AZURE_OPENAI_ENDPOINT=https://your-foundry-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-10-21

# Anthropic API (production target for the Anthropic SDK)
# Or point this at your Foundry deployment hosting Claude
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-opus-4-7
